<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.UdinConverter" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green_light</item>
        <item name="android:statusBarColor">@color/green_dark</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="motionDurationShort2">0</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>

    <style name="Animation.UdinConverter.NoAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <style name="ThemeOverlay.UdinConverter.ProfileDialog" parent="ThemeOverlay.Material3.Dialog">
        <item name="android:windowAnimationStyle">@style/Animation.UdinConverter.NoAnimation</item>
    </style>
</resources>
